# CareLoop Environment Configuration Template
DB_HOST=localhost
DB_PORT=3306
DB_USER=careloop_api
DB_PASSWORD=careloop_dev_pass
DB_NAME=careloop

# The demo seeder deletes existing rows in the configured DB; enable explicitly
# only when using a disposable database.
CARELOOP_ALLOW_DEMO_RESET=false

JWT_SECRET=careloop-super-secure-jwt-secret-key-32chars
DEVICE_API_KEY=demo-device-key-change-me

# Twilio SMS (Disabled by default in demo mode)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Hosted LLM API (for Q&A RAG and draft summaries)
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
CHROMA_PATH=./chroma

# Safety & Feature Flags
ENABLE_WOUND_AI_DIAGNOSIS=false
ENABLE_AUDIO_ANALYSIS=false
